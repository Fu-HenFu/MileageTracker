{
  "expo": {
    "name": "Mileage Tracker",
    "slug": "mileage-tracker",
    "version": "1.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tom.mileagetracker",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to measure driving distance for tax deduction reports.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We track your driving trips in the background to automatically calculate your tax savings.",
        "UIBackgroundModes": ["location"]
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Mileage Tracker to track your trips in the background for tax write-offs."
        }
      ]
    ]
  }
}